---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site, contact, legal, formatDate, telLink } from '../config/site.config';
import { breadcrumbSchema, home } from '../lib/schema';

const crumbs = [home, { label: 'מדיניות פרטיות' }];
---
<BaseLayout title="מדיניות פרטיות" description={`מדיניות הפרטיות של ${site.name}: איזה מידע נאסף באתר, למה, איפה הוא נשמר ומה הזכויות שלכם.`} schema={[breadcrumbSchema(crumbs)]}>
  <PageHero title="מדיניות פרטיות" lead={`עודכן לאחרונה: ${formatDate(legal.privacyUpdated)}`} crumbs={crumbs} />
  <section class="section">
    <div class="container prose">
      <p>{legal.businessName} ("העסק") מכבד את פרטיות הגולשים באתר. מדיניות זו מסבירה איזה מידע נאסף באתר, לאיזו מטרה ומה הזכויות שלכם לגביו, בהתאם לחוק הגנת הפרטיות, התשמ"א-1981 ותקנותיו, לרבות תיקון 13 לחוק.</p>

      <h2>איזה מידע נאסף</h2>
      <ul>
        <li><strong>מידע שאתם מוסרים בטופס:</strong> שם, טלפון, נושא הפנייה ופרטים נוספים, אם בחרתם לכתוב.</li>
        <li><strong>מידע טכני:</strong> העמוד שממנו נשלחה הפנייה ומקור ההגעה לאתר (למשל פרמטרי קמפיין), לצורך שיפור השירות.</li>
        <li><strong>עוגיות מדידה:</strong> רק אם אישרתם זאת בבאנר העוגיות. ללא אישור, לא נטענים כלי מדידה.</li>
      </ul>
      <p>המחשבון, בוחר התקלות ותזכורת היומן פועלים בדפדפן שלכם בלבד. הנתונים שאתם מזינים בהם לא נשלחים לעסק, אלא אם בחרתם לשלוח אותם בוואטסאפ. שיחות טלפון והודעות וואטסאפ מתנהלות ישירות מול העסק, בכפוף לתנאים של ספק השירות.</p>

      <h2>למה המידע משמש</h2>
      <p>המידע משמש רק כדי לחזור אליכם, לתאם ביקור ולשפר את האתר. המידע לא נמכר ולא מועבר לצד שלישי לצורכי שיווק.</p>

      <h2>מסירת המידע אינה חובה</h2>
      <p>אינכם חייבים למסור מידע. בלי שם ומספר טלפון לא נוכל לחזור אליכם, ותמיד אפשר להתקשר ישירות.</p>

      <h2>היכן המידע נשמר</h2>
      <p>המידע נשמר או עובר דרך ספקי שירות שמסייעים בהפעלת האתר:</p>
      <ul>{legal.dataProcessors.map((p) => <li>{p}</li>)}</ul>
      <p>ייתכן שחלק מהספקים שומרים מידע מחוץ לישראל, בכפוף להגנות מתאימות.</p>

      <h2>אבטחת מידע</h2>
      <p>האתר פועל בתקשורת מוצפנת (HTTPS). הגישה לפניות מוגבלת לבעל העסק בלבד. יחד עם זאת, אין מערכת חסינה לחלוטין.</p>

      <h2>הזכויות שלכם</h2>
      <p>אתם רשאים לעיין במידע שנשמר עליכם, לבקש לתקן אותו או למחוק אותו. פנו אלינו בכתובת <a href={`mailto:${contact.email}`}>{contact.email}</a> ונטפל בבקשה בתוך זמן סביר.</p>

      <h2>עוגיות</h2>
      <p>אפשר לשנות את בחירת העוגיות בכל רגע דרך הקישור "הגדרות עוגיות" בתחתית האתר.</p>

      <h2>פרטי קשר</h2>
      <p>{legal.businessName}, עוסק מורשה {legal.businessId}, {contact.baseArea}. טלפון: <a href={telLink} class="ltr">{contact.phone}</a>.</p>
    </div>
  </section>
</BaseLayout>
