---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CapacityDial from '../components/CapacityDial.astro';
import FaqList from '../components/FaqList.astro';
import CtaPanel from '../components/CtaPanel.astro';
import { calculator, site } from '../config/site.config';
import { breadcrumbSchema, faqSchema, home } from '../lib/schema';

const crumbs = [home, { label: 'מחשבון כ"ס' }];
const calcFaq = [
  { q: 'מה ההבדל בין כ"ס ל-BTU?', a: 'BTU הוא יחידת מדידה של כמות החום שהמזגן מוציא מהחדר בשעה. כ"ס הוא הכינוי המסחרי בישראל. מזגן של 1 כ"ס מוציא בערך 9,000 BTU, ומזגן של 1.5 כ"ס בערך 13,500 BTU. הנתון המדויק כתוב במפרט של כל דגם.' },
  { q: 'למה לא לקנות מזגן גדול יותר ליתר ביטחון?', a: 'מזגן גדול מדי מגיע לטמפרטורה מהר ונכבה לפני שהספיק לייבש את האוויר. החדר נשאר לח, המדחס נדלק ונכבה הרבה פעמים, וזה שוחק אותו ומעלה את צריכת החשמל.' },
  { q: 'מה משנה את החישוב יותר מכל?', a: 'שמש ישירה וגג חשוף. חדר עם חלון מערבי גדול בקומה אחרונה יכול לצרוך פי 1.3 מחדר באותו גודל בקומת ביניים עם חלון צפוני.' },
  { q: 'איך מחשבים חדר פתוח למטבח או לסלון?', a: 'מחשבים את כל השטח הפתוח כחדר אחד ומוסיפים את החום של המטבח. בחלל גדול מאוד לפעמים עדיף שני מזגנים קטנים או מיני מרכזי, בשביל פיזור אוויר אחיד.' },
];
const howTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'איך מחשבים כמה כ"ס צריך למזגן',
  step: [
    { '@type': 'HowToStep', text: `מכפילים את שטח החדר ב-${calculator.btuPerM2} BTU למ"ר, בתקרה רגילה של ${calculator.standardCeiling} מטר.` },
    { '@type': 'HowToStep', text: 'מתאימים לפי גובה התקרה, כמות השמש ואם זו קומה אחרונה.' },
    { '@type': 'HowToStep', text: `מוסיפים ${calculator.perExtraPerson} BTU לכל אדם מעבר לשניים, ו-${calculator.kitchen.toLocaleString('he-IL')} BTU לחדר פתוח למטבח.` },
    { '@type': 'HowToStep', text: 'בוחרים את המזגן הסטנדרטי הקרוב שמכסה את התוצאה.' },
  ],
};
---
<BaseLayout
  title='מחשבון כ"ס למזגן: כמה כוח סוס צריך החדר?'
  description={`מחשבון כ"ס ו-BTU למזגן לפי שטח, שמש, קומה, תקרה ומספר אנשים. תוצאה מיידית ושליחה לטכנאי בלחיצה. ${site.name}.`}
  schema={[breadcrumbSchema(crumbs), faqSchema(calcFaq), howTo]}
>
  <PageHero
    title='כמה כ"ס צריך המזגן שלכם?'
    lead="הזיזו את הסליידר ובחרו את מה שמתאים לחדר. החישוב מתעדכן מיד, ואפשר לשלוח את התוצאה בוואטסאפ ולקבל הצעת מחיר."
    crumbs={crumbs}
  />
  <section class="section">
    <div class="container"><CapacityDial id="calc" /></div>
  </section>

  <section class="section section--panel">
    <div class="container cols">
      <div class="prose">
        <h2>איך המחשבון עובד</h2>
        <p>נקודת ההתחלה היא {calculator.btuPerM2} BTU לכל מטר רבוע, בחדר עם תקרה רגילה של {calculator.standardCeiling} מטר ושני אנשים. זה הכלל המקובל בישראל לדירות עם בידוד סביר.</p>
        <ul>
          <li>תקרה גבוהה יותר מגדילה את נפח האוויר, והחישוב גדל באותו יחס.</li>
          <li>שמש חזקה, בדרך כלל חלון מערבי או דרומי, מוסיפה {Math.round((calculator.sun.high - 1) * 100)}%.</li>
          <li>קומה אחרונה או גג חשוף מוסיפים {Math.round((calculator.topFloor - 1) * 100)}%.</li>
          <li>כל אדם נוסף מעבר לשניים מוסיף {calculator.perExtraPerson} BTU.</li>
          <li>חדר פתוח למטבח מוסיף {calculator.kitchen.toLocaleString('he-IL')} BTU בגלל החום מהבישול.</li>
        </ul>
        <p>{calculator.disclaimer}</p>
      </div>
      <div>
        <h2>הגדלים הנפוצים</h2>
        <table class="sizes">
          <caption class="visually-hidden">הספק מזגן בכ"ס וב-BTU</caption>
          <thead><tr><th scope="col">כ"ס</th><th scope="col">BTU בערך</th><th scope="col">מתאים בדרך כלל ל-</th></tr></thead>
          <tbody>
            {calculator.sizes.map((s) => (
              <tr>
                <td>{s.hp}</td>
                <td>{s.btu.toLocaleString('he-IL')}</td>
                <td>עד {Math.round(s.btu / calculator.btuPerM2)} מ"ר</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>שאלות על הספק מזגן</h2>
      <FaqList items={calcFaq} />
    </div>
  </section>

  <CtaPanel title="רוצים מדידה אמיתית?" text="ביקור מדידה לפני התקנה, והמלצה על הספק לכל חדר בבית." message='שלום עומרי, אשמח לתאם מדידה לפני התקנת מזגן' />
</BaseLayout>

<style>
  .cols { display: grid; gap: var(--space-7); }
  @media (min-width: 960px) { .cols { grid-template-columns: 1.1fr 0.9fr; gap: var(--space-8); } }
  .prose h2 { margin-top: 0; }
  .sizes { width: 100%; border-collapse: collapse; background: var(--c-frost); border-radius: var(--r-panel); overflow: hidden; }
  .sizes th, .sizes td { padding: 0.8rem 1rem; text-align: start; border-bottom: 1px solid var(--c-line); }
  .sizes th { background: var(--c-ink); color: #fff; font-weight: 600; font-size: 0.9rem; }
  .sizes td:first-child { font: 700 1.8rem/1 var(--font-display); }
</style>
