---
// Services as spec rows (image, what it is, price from), not a grid of identical cards.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Service } from '../config/site.config';
interface Props { items: Service[] }
const { items } = Astro.props;
---
<ul class="svc-list">
  {items.map((s) => (
    <li>
      <a href={`/services/${s.slug}/`}>
        <Image src={s.image} alt="" widths={[160, 320]} sizes="160px" loading="lazy" class="thumb" />
        <span class="body">
          <span class="t"><Icon name={s.icon} size={20} /> {s.title}</span>
          <span class="d">{s.short}</span>
        </span>
        <span class="price"><span class="from">החל מ-</span>{s.priceFrom.toLocaleString('he-IL')} ₪</span>
        <Icon name="arrow" size={20} class="go" />
      </a>
    </li>
  ))}
</ul>

<style>
  .svc-list { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--c-ink); }
  li { border-bottom: 1px solid var(--c-line); }
  a {
    display: grid; grid-template-columns: 96px 1fr auto; gap: 0.4rem 1.25rem; align-items: center;
    padding: 1rem 0; color: inherit; text-decoration: none;
  }
  .thumb { grid-row: span 2; width: 96px; height: 72px; object-fit: cover; border-radius: var(--r-control); }
  .t { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 1.15rem; }
  .t :global(svg) { color: var(--c-lime-deep); }
  .d { display: block; color: var(--c-slate); font-size: 0.96rem; }
  .body { display: grid; gap: 0.15rem; }
  .price { font: 700 2rem/1 var(--font-display); white-space: nowrap; }
  .from { font: 500 0.8rem var(--font-body); color: var(--c-slate); margin-inline-end: 0.25rem; }
  .go { display: none; color: var(--c-lime-deep); transition: transform 200ms var(--ease); }
  a:hover .t { text-decoration: underline; text-decoration-color: var(--c-lime); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  @media (min-width: 760px) {
    a { grid-template-columns: 120px 1fr auto auto; padding: 1.1rem 0.25rem; }
    .thumb { width: 120px; height: 84px; grid-row: auto; }
    .go { display: block; }
    a:hover .go { transform: translateX(-4px); }
  }
  @media (max-width: 759px) {
    .price { grid-column: 2; font-size: 1.6rem; }
  }
</style>
