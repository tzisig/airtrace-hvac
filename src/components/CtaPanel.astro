---
import Icon from './Icon.astro';
import { contact, telLink, waLink } from '../config/site.config';
interface Props { title?: string; text?: string; message?: string }
const {
  title = 'המזגן לא עושה מה שהוא אמור?',
  text = `${contact.sameDayLabel}. ${contact.responsePromise}.`,
  message,
} = Astro.props;
---
<section class="cta">
  <div class="container inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a class="btn" href={telLink}><Icon name="phone" size={20} /> <span class="ltr">{contact.phone}</span></a>
      <a class="btn btn--wa" href={waLink(message)}><Icon name="whatsapp" size={20} /> הודעה בוואטסאפ</a>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--c-lime); color: var(--c-ink); padding-block: var(--space-7); }
  .inner { display: grid; gap: var(--space-5); align-items: center; }
  @media (min-width: 900px) { .inner { grid-template-columns: 1fr auto; } }
  h2 { margin-bottom: var(--space-3); }
  p { margin: 0; font-size: 1.1rem; max-width: 36rem; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .actions .btn:first-child { background: var(--c-ink); color: #fff; }
  .actions .btn:first-child:hover { background: var(--c-ink2); }
</style>
