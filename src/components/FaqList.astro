---
import Icon from './Icon.astro';
import type { Faq } from '../config/site.config';
interface Props { items: Faq[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary><span>{f.q}</span><span class="pm" aria-hidden="true"><Icon name="plus" size={18} /></span></summary>
      <div class="answer"><p>{f.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 2px solid var(--c-ink); }
  details { border-bottom: 1px solid var(--c-line); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; cursor: pointer; list-style: none;
    padding: 1.15rem 0; font-weight: 700; font-size: 1.08rem; line-height: 1.4;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover span:first-child { text-decoration: underline; text-decoration-color: var(--c-lime); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .pm {
    flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%;
    background: var(--c-lime-soft); color: var(--c-lime-deep); transition: transform 220ms var(--ease), background-color 220ms;
  }
  details[open] .pm { transform: rotate(45deg); background: var(--c-lime); color: var(--c-ink); }
  .answer { padding: 0 0 1.25rem; color: var(--c-slate); max-width: 44rem; }
  .answer p { margin: 0; }
</style>
