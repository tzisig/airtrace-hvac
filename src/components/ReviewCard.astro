---
import type { Review } from '../config/site.config';
import { serviceBySlug, formatDate } from '../config/site.config';
interface Props { review: Review }
const { review: r } = Astro.props;
const svc = serviceBySlug(r.service);
---
<figure class="review">
  <p class="stars" role="img" aria-label={`דירוג ${r.rating} מתוך 5`}>
    {Array.from({ length: 5 }, (_, i) => <span class:list={{ off: i >= r.rating }} aria-hidden="true">★</span>)}
  </p>
  <blockquote><p>{r.text}</p></blockquote>
  <figcaption>
    <strong>{r.name}</strong>, {r.city}
    <span class="meta">{svc && <a href={`/services/${svc.slug}/`}>{svc.title}</a>}, {formatDate(r.date)}</span>
  </figcaption>
</figure>

<style>
  .review { margin: 0; padding: 1.4rem 0; border-top: 1px solid var(--c-line); display: grid; gap: 0.6rem; }
  .stars { margin: 0; color: var(--c-lime-deep); letter-spacing: 0.1em; font-size: 1.05rem; }
  .off { color: var(--c-line); }
  blockquote { margin: 0; }
  blockquote p { margin: 0; font-size: 1.05rem; }
  figcaption { font-size: 0.95rem; }
  .meta { display: block; color: var(--c-slate); font-size: 0.875rem; }
  .meta a { color: inherit; }
</style>
